      "taste_docs": [
        "docs/design.md"
      ],
      "commands": [
        {
          "run": "npm run test",
          "does": "Alive CSS, phone menu, claims and discovery files"
        },
        {
          "run": "npm run seo",
          "does": "Regenerate the discovery files"
        }
      ]
    },
    {
