      "kind": "public-site",
      "taste_docs": [
        "docs/design.md"
      ],
      "commands": [
        {
          "run": "npm run check",
          "does": "Lint, tests and stale generated files"
        },
        {
          "run": "npm run check:fit",
          "does": "Card height, sideways scroll, heading lines and margins at four widths"
        },
        {
          "run": "npm run check:upstream",
          "does": "Hub colors and instruments against each project's own source"
        }
      ]
    },
    {
