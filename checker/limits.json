{
  "max_function_lines": 15,
  "ruff": "ruff==0.17.0",
  "test_paths": ["tests/*", "test/*", "*/tests/*", "*/test/*", "*test_*.py", "*.test.*", "*.spec.*"],
  "shell_paths": ["*.sh", "*.bash", "*.zsh", "*.yml", "*.yaml", "*.json", "*.plist", "*.tmpl", "Dockerfile*", "Makefile", "Justfile", "justfile"],
